{
  "name": "@sqx717/dashboard",
  "version": "1.1.0",
  "description": "可复用的 Vite + React 大屏（Dashboard）外壳库：可拖拽/缩放的格子布局与业务组件注册表。布局数据与持久化、提示、CSS/主题由消费方负责。",
  "keywords": [
    "bigscreen",
    "dashboard",
    "react",
    "vite",
    "大屏"
  ],
  "homepage": "https://github.com/lnoo/dashboard-lib#readme",
  "bugs": {
    "url": "https://github.com/lnoo/dashboard-lib/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnoo/dashboard-lib.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && publint",
    "prepublishOnly": "npm run check",
    "publish:patch": "npm version patch && npm publish --access public",
    "publish:minor": "npm version minor && npm publish --access public",
    "publish:major": "npm version major && npm publish --access public"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.8.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "publint": "^0.3.25",
    "re-resizable": "^6.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.7.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.0.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "clsx": "*",
    "lucide-react": "^1.8.0",
    "re-resizable": "^6.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-draggable": "^4.4.6",
    "tailwind-merge": "*"
  }
}
